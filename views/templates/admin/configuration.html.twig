{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {{ form_start(psturnstileConfigurationForm) }}
  <div class="card">
    <h3 class="card-header">
      <i class="material-icons">security</i> {{ 'Cloudflare Turnstile settings'|trans({}, 'Modules.Psturnstile.Admin') }}
    </h3>
    <div class="card-body">
      <div class="form-wrapper">
        {{ form_widget(psturnstileConfigurationForm) }}
      </div>
    </div>
    <div class="card-footer">
      <div class="d-flex justify-content-end">
        <button class="btn btn-primary" id="psturnstile-save-button" type="submit">
          {{ 'Save'|trans({}, 'Admin.Actions') }}
        </button>
      </div>
    </div>
  </div>
  {{ form_end(psturnstileConfigurationForm) }}
{% endblock %}
